; ..\iLLD_1_0_1_11_0\Src\BaseSw\iLLD\TC23A\Tricore\Mtu\Std\IfxMtu.h	   366   * \return None
; ..\iLLD_1_0_1_11_0\Src\BaseSw\iLLD\TC23A\Tricore\Mtu\Std\IfxMtu.h	   367   */
